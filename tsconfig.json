/* To learn more about this file see: https://angular.io/config/tsconfig. */
{
    "compileOnSave": false,
    "compilerOptions": {
        "baseUrl": "./src",
        "outDir": "./dist/out-tsc",
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "sourceMap": true,
        "declaration": false,
        "downlevelIteration": true,
        "experimentalDecorators": true,
        "moduleResolution": "node",
        "importHelpers": true,
        "target": "ES2022",
        "module": "es2020",
        "lib": ["es2018", "dom"],
        "paths": {
            // NEW
            "@configs/*": ["app/configs/*"],
            "@contact/*": ["app/features/contact/*"],
            "@core/*": ["app/core/*"],
            "@countries/*": ["app/features/countries/*"],
            "@insurance/*": ["app/features/insurance/*"],
            "@insurer/*": ["app/features/insurer/*"],
            "@insurance-type/*": ["app/features/insurance-type/*"],
            "@notifier/*": ["app/features/notifier/*"],
            "@shared/*": ["app/shared/*"],
            "@features-legacy/*": ["app/features-legacy/*"],
            "@payment/*": ["app/features/payment/*"],
            "@policy-complement/*": ["app/features/policy-complement/*"],
            "@policy/*": ["app/features/policy/*"],
            "@quotation/*": ["app/features/quotation/*"],
            "@seller-commission-suggestions/*": [
                "app/features/seller-commission-suggestions/*"
            ],
            "@sinister/*": ["app/features/sinister/*"],
            "@state/*": ["app/features/state/*"],
            "@task-progress-status/*": ["app/features/task-progress-status/*"],
            "@tasks/*": ["app/features/tasks/*"],
            "@users/*": ["app/features/users/*"],
            "@workspace/*": ["app/features/workspace/*"],
            "@workspace-users/*": ["app/features/workspace-users/*"],

            // LEGACY
            "@components/*": ["app/legacy/components/*"],
            "@constants/*": ["app/legacy/constants/*"],
            "@directives/*": ["app/legacy/directives/*"],
            "@guards/*": ["app/legacy/guards/*"],
            "@helpers/*": ["app/legacy/helpers/*"],
            "@interceptors/*": ["app/legacy/interceptors/*"],
            "@interfaces/*": ["app/legacy/interfaces/*"],
            "@pages/*": ["app/legacy/pages/*"],
            "@pipes/*": ["app/legacy/pipes/*"],
            "@services/*": ["app/legacy/services/*"],
            "@env/*": ["environments/*"]
        },
        "useDefineForClassFields": false
    },
    "angularCompilerOptions": {
        "enableI18nLegacyMessageIdFormat": false,
        "strictInjectionParameters": true,
        "strictInputAccessModifiers": true,
        "strictTemplates": true
    }
}
